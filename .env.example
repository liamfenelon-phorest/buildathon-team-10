# Phorest Wrapped — live data config.
# Copy to .env.local and fill in. If TOKEN/BUSINESS_ID/USER_ID are missing,
# the app falls back to the hardcoded demo persona.

# Bearer access token (with or without the "Bearer " prefix). Dev tokens are
# short-lived (~30 min) — refresh when you start getting 401s.
VITE_WRAPPED_TOKEN=

# From the token payload: business_id and user_id.
VITE_WRAPPED_BUSINESS_ID=
VITE_WRAPPED_USER_ID=

# Optional: target a specific staff member (defaults to the token's user).
# VITE_WRAPPED_STAFF_ID=

# Optional: reporting window. One of TODAY | WEEK_TO_DATE | MONTH_TO_DATE |
# YEAR_TO_DATE. Defaults to MONTH_TO_DATE.
# VITE_WRAPPED_PRESET=MONTH_TO_DATE

# Optional overrides.
# VITE_WRAPPED_TIMEZONE=Europe/Dublin
# VITE_WRAPPED_STAFF_NAME=Jess Murphy
# VITE_WRAPPED_SALON_NAME=Bloom Hair & Beauty

# Optional: override the GraphQL endpoint. Defaults to "/api-facade/graphql",
# which the Vite dev server proxies to the dev gateway (see vite.config.ts).
# VITE_WRAPPED_API_URL=/api-facade/graphql
