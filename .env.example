# Copy to .env.local and fill in. Without these, the app uses hardcoded demo data.
#
# Get a token from auth-service (see api-facade README):
#   curl -s -H "Content-Type: application/json" \
#     -X POST https://api-gateway-dev.phorest.com/auth/oauth/token \
#     -d '{"grant_type":"basic","client_type":"user","username":"you@demo.ie","password":"..."}'
# Then decode it at https://jwt.io to read business_id / user_id.

VITE_API_FACADE_URL=https://api-gateway-dev.phorest.com/api-facade/graphql
VITE_API_TOKEN=
VITE_BUSINESS_ID=
VITE_BRANCH_ID=
VITE_STAFF_ID=
VITE_USER_ID=

# Optional display overrides (purchases query has no staff/salon name fields)
VITE_STAFF_NAME=
VITE_SALON_NAME=
VITE_PERIOD=2025
VITE_CURRENCY=€

# Date range filter (applied client-side; api-facade has no range filter).
# If left blank and VITE_PERIOD is a plain year, the whole year is used.
# VITE_START_DATE=2025-01-01
# VITE_END_DATE=2025-12-31
